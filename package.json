{
  "name": "dsh-idea-git",
  "version": "0.5.4",
  "description": "IDEA-style Git tool window for DeepSeek Harness: changes & commit, commit graph log, console, diff, branches/remotes, stash/worktrees and AI commit messages.",
  "keywords": [
    "blame",
    "commit-graph",
    "cordis",
    "deepseek-harness",
    "diff",
    "dsh",
    "git",
    "idea",
    "lfs",
    "plugin",
    "worktree"
  ],
  "homepage": "https://github.com/zhuweiyou/dsh-idea-git#readme",
  "bugs": {
    "url": "https://github.com/zhuweiyou/dsh-idea-git/issues"
  },
  "license": "MIT",
  "author": "zhuweiyou <i@zhuweiyou.com> (https://github.com/zhuweiyou)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhuweiyou/dsh-idea-git.git"
  },
  "files": [
    "lib",
    "dist/client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./dist/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp build --mode host && vp build --mode client",
    "typecheck": "vp check --no-fmt --no-lint",
    "test": "vp test run",
    "lint": "vp lint src",
    "format": "vp fmt . --write",
    "format:check": "vp fmt . --check",
    "prepack": "npm run build",
    "prepublishOnly": "npm run build && npm run test",
    "check": "vp check"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "clsx": "^2.1.1",
    "typescript": "^5.7.0",
    "vite-plus": "catalog:"
  },
  "packageManager": "pnpm@11.25.0",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  }
}

{
  "name": "dsh-idea-git",
  "version": "0.1.0",
  "type": "module",
  "description": "IDEA-style Git tool window for DeepSeek Harness: changes & commit, commit graph log, console, diff, branches/remotes, stash/worktrees and AI commit messages.",
  "author": "zhuweiyou <zhuweiyou@users.noreply.github.com>",
  "license": "MIT",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "git",
    "idea",
    "diff",
    "blame",
    "lfs",
    "worktree",
    "commit-graph"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhuweiyou/dsh-idea-git.git"
  },
  "homepage": "https://github.com/zhuweiyou/dsh-idea-git#readme",
  "bugs": {
    "url": "https://github.com/zhuweiyou/dsh-idea-git/issues"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./dist/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "dist/client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:host": "node scripts/build-host.mjs",
    "build:client": "node scripts/build-client.mjs",
    "typecheck": "tsc --noEmit",
    "test:host": "node scripts/test-host.mjs",
    "test": "node scripts/test-host.mjs",
    "prepack": "npm run build",
    "prepublishOnly": "npm run build && npm run test:host"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "clsx": "^2.1.1",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.0"
  }
}
